# Server Configuration
PROJECT_NAME="AI Crop Disease Detection API"
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Upload Limits & Validation
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=".jpg,.jpeg,.png,.webp"
ALLOWED_IMAGE_MIME_TYPES="image/jpeg,image/png,image/webp"

# Database Configuration (Planned for Phase 6)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=crop_disease_db

# Security & Authentication (Planned for Phase 7)
# JWT_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
